// mandelbrot: counts the points of an n×n grid that stay in the set
// after 50 iterations. Stresses tight float loops.

fun main() {
    let n = parse_i64(args()[1]).unwrap();
    let size = n as f64;
    let mut inside = 0;
    for y in 0..n {
        let ci = 2.0 * y as f64 / size - 1.0;
        for x in 0..n {
            let cr = 2.0 * x as f64 / size - 1.5;
            let mut zr = 0.0;
            let mut zi = 0.0;
            let mut tr = 0.0;
            let mut ti = 0.0;
            let mut i = 0;
            while i < 50 && tr + ti <= 4.0 {
                zi = 2.0 * zr * zi + ci;
                zr = tr - ti + cr;
                tr = zr * zr;
                ti = zi * zi;
                i += 1;
            }
            if tr + ti <= 4.0 {
                inside += 1;
            }
        }
    }
    println(inside);
}
