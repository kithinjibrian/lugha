// binarytrees: builds and walks many short-lived binary trees and one
// long-lived one. Stresses allocation and the Boehm GC: every node is a
// separate heap object, as in every other language's version.

enum Tree {
    Leaf,
    Node(Tree, Tree),
}

fun make(depth: i64): Tree = if depth == 0 {
    Tree.Node(Tree.Leaf, Tree.Leaf)
} else {
    Tree.Node(make(depth - 1), make(depth - 1))
};

fun check(t: Tree): i64 = match t {
    Leaf => 0,
    Node(l, r) => 1 + check(l) + check(r),
};

fun main() {
    let max_depth = parse_i64(args()[1]).unwrap();
    println("stretch {max_depth + 1} {check(make(max_depth + 1))}");
    let long_lived = make(max_depth);
    let mut depth = 4;
    while depth <= max_depth {
        let iterations = 1 << max_depth - depth + 4;
        let mut sum = 0;
        for _ in 0..iterations {
            sum += check(make(depth));
        }
        println("{iterations} {depth} {sum}");
        depth += 2;
    }
    println("long {max_depth} {check(long_lived)}");
}
