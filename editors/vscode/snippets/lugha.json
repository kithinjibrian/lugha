{
  "Function": {
    "prefix": "fun",
    "body": [
      "fun ${1:name}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "A function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fun main() {",
      "\t$0",
      "}"
    ],
    "description": "The program's entry point"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i64},",
      "}"
    ],
    "description": "A struct"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:First},",
      "\t${3:Second},",
      "}"
    ],
    "description": "An enum"
  },
  "Impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "\tfun ${2:method}(self) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Methods for a type"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfun ${2:method}(self): ${3:i64};",
      "}"
    ],
    "description": "An interface"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:geo};"
    ],
    "description": "Import a module"
  },
  "Extern": {
    "prefix": "extern",
    "body": [
      "extern fun ${1:name}(${2:x}: ${3:i64}): ${4:i64};"
    ],
    "description": "A C function (spec §8)"
  },
  "Extern type": {
    "prefix": "externtype",
    "body": [
      "extern type ${1:Name};"
    ],
    "description": "A handle: an opaque C pointer type (v16)"
  },
  "Extern struct": {
    "prefix": "externstruct",
    "body": [
      "extern struct ${1:Name} {",
      "\t${2:x}: ${3:f32},",
      "}"
    ],
    "description": "A struct with C's layout, passed to C by value (v16)"
  },
  "Extern with callback": {
    "prefix": "externcb",
    "body": [
      "extern fun ${1:connect}(${2:callback}: fun(${3:i64}, data), user: data, destroy: release);"
    ],
    "description": "A C function taking a callback; callers write neither `user` nor `destroy` (v16)"
  },
  "Doc comment": {
    "prefix": "doc",
    "body": [
      "/**",
      " * ${1:What it does.}",
      " * @param ${2:name} ${3:its meaning}",
      " */"
    ],
    "description": "A doc comment, shown by hover and completion"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "An if"
  },
  "If else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "An if with an else"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "A while loop"
  },
  "For of": {
    "prefix": "forof",
    "body": [
      "for ${1:x} of ${2:xs} {",
      "\t$0",
      "}"
    ],
    "description": "A loop over an array or iterator"
  },
  "For in": {
    "prefix": "forin",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "A loop over a range"
  },
  "If let": {
    "prefix": "iflet",
    "body": [
      "if let ${1:Some(v)} = ${2:o} {",
      "\t$0",
      "}"
    ],
    "description": "Test one pattern"
  },
  "Let else": {
    "prefix": "letelse",
    "body": [
      "let ${1:Some(v)} = ${2:o} else {",
      "\t${3:return;}",
      "};"
    ],
    "description": "Bind a pattern, or leave"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:x} {",
      "\t${2:0} => ${3:{\\}},",
      "\t_ => ${4:{\\}},",
      "}"
    ],
    "description": "A match"
  },
  "Spawn": {
    "prefix": "spawn",
    "body": [
      "let ${1:t} = spawn fun() {",
      "\t$0",
      "}();",
      "${1:t}.join();"
    ],
    "description": "Run a closure in a green thread, then wait for it (v17)"
  },
  "Channel": {
    "prefix": "chan",
    "body": [
      "let ${1:ch}: Chan<${2:i64}> = Chan.buffered(${3:1});"
    ],
    "description": "A channel between green threads (v17)"
  },
  "Select": {
    "prefix": "select",
    "body": [
      "select {",
      "\t${1:m} = ${2:c}.recv() => ${3:println(m)},",
      "\tafter(${4:100}) => ${5:println(\"timed out\")},",
      "}"
    ],
    "description": "Wait on channels, with a timeout (v17)"
  },
  "Actor": {
    "prefix": "actor",
    "body": [
      "actor ${1:Name} {",
      "\t${2:count}: ${3:i64},",
      "\tfun ${4:get}(self): ${3:i64} = self.${2:count};",
      "}"
    ],
    "description": "An actor: state one green thread owns, reached through messages (v17)"
  }
}
