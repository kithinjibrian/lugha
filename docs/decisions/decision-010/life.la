// Game of life: the idiomatic double buffer copies the whole grid twice per step.
fun neighbours(g: bool[][], r: i64, c: i64): i64 {
    let n = g.len;
    let mut count = 0;
    for dr in 0..3 {
        for dc in 0..3 {
            if dr != 1 || dc != 1 {
                let rr = (r + dr + n - 1) % n;
                let cc = (c + dc + n - 1) % n;
                if g[rr][cc] { count += 1; }
            }
        }
    }
    count
}

fun main() {
    let n = 200;
    let mut grid = [[false; n]; n];
    let mut seed = 42;
    for r in 0..n {
        for c in 0..n {
            seed = (seed * 1103515245 + 12345) % 2147483648;
            grid[r][c] = seed % 3 == 0;
        }
    }
    for step in 0..100 {
        let mut next = grid;
        for r in 0..n {
            for c in 0..n {
                let k = neighbours(grid, r, c);
                next[r][c] = k == 3 || (grid[r][c] && k == 2);
            }
        }
        grid = next;
    }
    let mut alive = 0;
    for row of grid { for cell of row { if cell { alive += 1; } } }
    println(alive);
}
