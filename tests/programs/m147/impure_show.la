// A type's own `show` runs when a constant interpolates the value, so it
// must be pure too (E0445).
struct Point { x: i64, y: i64 }

impl Point {
    fun show(self): string {
        println("showing a point");
        "({self.x}, {self.y})"
    }
}

const LABEL: string = "origin is {Point { x: 0, y: 0 }}";

fun main() {
    println(LABEL);
}
