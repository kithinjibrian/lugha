// Generic calls, interface values, closures, maps and `Ref` while
// computing a constant: all pure (milestone 147).
interface Shape {
    fun area(self): i64;
}

struct Square { side: i64 }
impl Square { fun area(self): i64 = self.side * self.side; }

struct Rect { w: i64, h: i64 }
impl Rect { fun area(self): i64 = self.w * self.h; }

fun total<T: Shape>(xs: T[]): i64 {
    let mut n = 0;
    for x of xs { n += x.area(); }
    n
}

fun mixed(): i64 {
    let shapes: Shape[] = [Square { side: 2 }, Rect { w: 2, h: 3 }];
    let mut n = 0;
    for s of shapes { n += s.area(); }
    n
}

fun counts(words: string[]): i64 {
    let mut m: Map<string, i64> = #{};
    for w of words { m.insert(w, m.get(w).unwrap_or(0) + 1); }
    let seen = Ref.new(0);
    for w of words { if m.get(w) == Some(1) { seen.set(seen.get() + 1); } }
    seen.get()
}

const SQUARES: i64 = total([Square { side: 3 }, Square { side: 4 }]);
const MIXED: i64 = mixed();
const UNIQUE: i64 = counts(["a", "b", "a", "c"]);
const DOUBLED: i64[] = [1, 2, 3].map(fun(x: i64): i64 = x * 2);

fun main() {
    println(SQUARES);
    println(MIXED);
    println(UNIQUE);
    println(DOUBLED);
}
