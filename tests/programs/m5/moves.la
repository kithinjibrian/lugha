// Move on last use (PRP-018) must never change what a program prints.
// Each case below would print something else if a copy were wrongly skipped.
fun main() {
    // A local declared outside the loop is copied on every iteration.
    let a = [0, 0];
    for i in 0..3 {
        let mut c = a;
        c[0] = c[0] + i + 1;
        println(c[0]);
    }

    // A later mention keeps the copy.
    let xs = [5];
    let mut ys = xs;
    ys[0] = 9;
    println(xs[0]);

    // Only the last of two mentions in one literal moves.
    let b = [1];
    let mut g = [b, b];
    g[1][0] = 7;
    println(g[0][0]);
    println(g[1][0]);

    // Shadowing: the later `s` is a different binding.
    let s = [3];
    let mut t = s;
    t[0] = 4;
    let s = [8];
    println(s[0]);
    println(t[0]);

    // Double buffering: `next` moves into `grid`, while reads of `grid`
    // during the step still see the previous generation.
    let mut grid = [1, 2, 3];
    for step in 0..3 {
        let mut next = grid;
        for i in 0..3 {
            next[i] = grid[i] + grid[(i + 1) % 3];
        }
        grid = next;
    }
    for v of grid {
        println(v);
    }
}
