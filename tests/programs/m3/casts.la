// Every spec §4 cast rule, in turn: exits with the number of the first
// rule that fails, or 42 if all hold.
fun main(): i32 {
    if (300 as u8) as i32 != 44 { return 1; }
    if (-1 as u8) as i32 != 255 { return 2; }
    if 2.9 as i32 != 2 { return 3; }
    if -2.9 as i32 != -2 { return 4; }
    if 1.0e20 as i32 != 2147483647 { return 5; }
    if (0.0 / 0.0) as u8 != 0 { return 6; }
    if (200 as u8) as f64 != 200.0 { return 7; }
    if (-7 as i32) as i64 != -7 { return 8; }
    if !(1.0 / 0.0 > 1.0e308) { return 9; }
    42
}
