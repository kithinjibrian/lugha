// Or-patterns and `mut` bindings (milestone 31).

enum Color { Red, Green, Blue }

interface Shape {
    fun area(self): f64;
}

struct Circle { r: f64 }

impl Circle {
    fun area(self): f64 = 3.0 * self.r * self.r;
    fun grow(mut self) { self.r *= 2.0; }
}

struct Square { side: f64 }

impl Square {
    fun area(self): f64 = self.side * self.side;
}

fun warm(c: Color): bool = match c {
    Red | Green => true,
    Blue => false,
};

fun small(n: Option<i64>): string = match n {
    Some(0 | 1 | 2) => "small",
    Some(x) if x < 0 => "negative",
    Some(_) => "big",
    None => "none",
};

fun kind(s: Shape): string = match s {
    _: Circle | _: Square => "known",
    _ => "other",
};

fun bigger(s: Shape): f64 = match s {
    mut c: Circle => {
        c.grow();
        c.area()
    }
    _ => 0.0,
};

fun main() {
    println("{warm(Color.Red)} {warm(Color.Blue)}");
    println("{small(Some(1))} {small(Some(-4))} {small(Some(9))} {small(None)}");
    println(kind(Circle { r: 1.0 }));
    let c: Shape = Circle { r: 1.0 };
    println("{bigger(c)} {c.area()}");

    // a `mut` binding of an array is the arm's own copy
    let o = Some([1, 2, 3]);
    match o {
        Some(mut xs) => {
            xs.push(4);
            println(xs.len);
        }
        None => {}
    }
    match o {
        Some(xs) => println(xs.len),
        None => {}
    }
    match 5 {
        mut n => {
            n += 1;
            println(n);
        }
    }
    match true {
        true | false => println("both"),
    }
}
