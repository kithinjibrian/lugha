struct Card { rank: i64, name: string }

fun main() {
    let xs = [5, 3, 9, 1, 3];
    let up = xs.sort_by(fun(a, b) = a < b);
    let down = xs.sort_by(fun(a, b) = a > b);
    println("{up[0]} {up[1]} {up[2]} {up[3]} {up[4]}");
    println("{down[0]} {down[4]}");
    println("{xs[0]} {xs[4]}");
    let words = ["pear", "apple", "fig"];
    let sorted = words.sort_by(fun(a, b) = a < b);
    println("{sorted[0]} {sorted[1]} {sorted[2]}");
    // Stable: equal ranks keep their original order.
    let cards = [Card { rank: 2, name: "a" }, Card { rank: 1, name: "b" }, Card { rank: 2, name: "c" }, Card { rank: 1, name: "d" }];
    let by_rank = cards.sort_by(fun(x, y) = x.rank < y.rank);
    println("{by_rank[0].name}{by_rank[1].name}{by_rank[2].name}{by_rank[3].name}");
    // 1000 elements in a scrambled order.
    let mut big: i64[] = [];
    let mut seed = 7;
    for i in 0..1000 {
        seed = (seed * 31 + 11) % 1009;
        big.push(seed);
    }
    let ordered = big.sort_by(fun(a, b) = a < b);
    let mut fine = ordered.len == 1000;
    for i in 1..ordered.len {
        if ordered[i - 1] > ordered[i] { fine = false; }
    }
    println(fine);
    println(big.fold(0, fun(s, x) = s + x) == ordered.fold(0, fun(s, x) = s + x));
    let one = [42];
    println(one.sort_by(fun(a, b) = a < b)[0]);
}
