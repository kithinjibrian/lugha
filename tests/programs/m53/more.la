// Every std.math function, at f64 and f32, IEEE edge cases, rounding of
// halves, the generic helpers on integers and floats, and named imports.
import std.math { sqrt, clamp };

fun hypot<T: Float>(a: T, b: T): T = math.sqrt(a * a + b * b);

// A generic float body: `0` and `1` are `T`, so `1 / 2` is spelled out.
fun mean<T: Float>(a: T, b: T): T {
    let one: T = 1;
    (a + b) * (one / (one + one))
}

fun main() {
    println(math.exp(1.0) == math.e());
    println(math.ln(math.e()));
    println(math.log10(1000.0));
    println(math.sin(0.0));
    println(math.cos(0.0));
    println(math.tan(0.0));
    println(math.atan2(1.0, 1.0) * 4.0);
    println(math.ceil(1.2));
    println(math.round(-2.5));
    println(math.round(0.49));
    println(math.sqrt(-1.0));
    println(math.ln(0.0));
    println(math.pow(0.0, -1.0));
    let x: f32 = 2.0;
    println(math.sqrt(x));
    println(hypot(x, x));
    println(mean(1.0, 2.0));
    println(math.abs(-2.5));
    println(math.abs(7));
    println(math.min(-1.5, 2.0));
    println(math.max("pear", "apple"));
    println(clamp(-4, 0, 10));
    println(clamp(0.5, 0.0, 1.0));
    println(math.pow(3.0, 2.0) + sqrt(16.0));
}
