// Two green threads allocate while `main` waits: the
// bundled collector clears only a little stack below each, so a 1 MiB
// green thread's stack doesn't overflow.
fun fill(n: i64): i64 {
    let mut xs: i64[] = [];
    for i in 0..n {
        xs.push(i);
    }
    xs.len
}

fun main() {
    let a = spawn fill(300000);
    let b = spawn fill(200000);
    println(a.join() + b.join());
}
