// Global constants (v17, milestone 109): any order, any plain type.
struct Point {
    x: i64,
    y: i64,
}

enum Color {
    Red,
    Mix(i64, i64),
}

const DOUBLE: i64 = MAX_PLAYERS * 2;
const MAX_PLAYERS: i64 = 8;
private const LIMIT: u64 = u64.MAX / 2;
const GREETING: string = "hello";
const PRIMES: i64[] = [2, 3, 5, 7];
const ZEROS: f64[] = [0.0; 3];
const ORIGIN: Point = Point { x: 0, y: -1 };
const PAIR: (bool, char) = (true, 'x');
const PICK: Option<Color> = Some(Color.Mix(1, MAX_PLAYERS));
const NONE: Option<i64> = None;
const RED: Color = Color.Red;
const FIRST: i64 = PRIMES[0] + ORIGIN.y;
const RATIO: f64 = MAX_PLAYERS as f64 / 3.0;
const DONE: Result<(), string> = Ok(());

fun total(xs: i64[]): i64 {
    let mut sum = 0;
    for x of xs {
        sum += x;
    }
    sum
}

fun main() {
    println(DOUBLE);
    println(LIMIT);
    println("{GREETING}, {MAX_PLAYERS} players");
    let mut ps = PRIMES;
    ps.push(11);
    println(ps);
    println(PRIMES);
    println(total(PRIMES));
    for p of PRIMES {
        print(p);
    }
    println();
    println(ZEROS);
    println(ORIGIN);
    println(ORIGIN.x);
    println(PAIR);
    println(PICK);
    println(NONE);
    println(RED);
    println(FIRST);
    println(RATIO);
    println(DONE);
    let f = fun(): i64 = MAX_PLAYERS + 1;
    println(f());
    let MAX_PLAYERS = 3;
    println(MAX_PLAYERS);
}
