// File streams (v17, milestone 146): create, append, read lines over
// `\r\n` and a last line without `\n`, the end of the file, the wrong mode,
// closing twice, and using a closed file.
import std.fs;

fun run(): Result<(), string> {
    let out = fs.create("notes.txt")?;
    out.write_text("first\r\nsecond\n")?;
    out.write("last".to_bytes())?;
    println(out.read(10));
    println(out.read_line());
    out.close();

    let log = fs.append("notes.txt")?;
    log.write_text("!\n")?;
    log.close();

    let f = fs.open("notes.txt")?;
    let copy = f;
    while true {
        match f.read_line()? {
            Some(line) => println("[{line}]"),
            None => {
                break;
            }
        }
    }
    println(copy.read_line());
    println(f.read(10));
    println(f.write_text("x"));
    println(f.write("y".to_bytes()));
    f.close();
    copy.close();
    println(f.read(10));
    println(f.read_line());
    println(copy.write_text("x"));

    let again = fs.create("notes.txt")?;
    again.write_text("fresh")?;
    again.close();
    println(read_file("notes.txt"));
    Ok(())
}

fun main() {
    println(run());
}
