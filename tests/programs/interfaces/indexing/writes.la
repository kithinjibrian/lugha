// A write through `set_index` is a `mut self` call: a mutable place, no
// compound operator, and no writes inside the element it reads.

struct Rows { rows: i64[][] }

impl Rows {
    fun index(self, i: i64): i64[] = self.rows[i];
    fun set_index(mut self, i: i64, v: i64[]) { self.rows[i] = v; }
}

fun main() {
    let r = Rows { rows: [[1]] };
    r[0] = [2];
    let mut s = r;
    s[0] += [3];
    s[0][0] = 4;
    s[0].push(5);
    s[0] = s.rows[0];
    for x of mut s[0] {
        x = 6;
    }
}
