// `[ ]` needs `index` (reads) or `set_index` (writes) of the right shape.

struct Plain { x: i64 }

struct Reader { x: i64 }

impl Reader {
    fun index(self, i: i64): i64 = self.x + i;
}

struct Wrong { x: i64 }

impl Wrong {
    fun index(mut self, i: i64): i64 = i;
}

fun pick<T>(t: T): i64 = t[0];

fun main() {
    let p = Plain { x: 1 };
    let a = p[0];
    let mut r = Reader { x: 1 };
    r[0] = 2;
    let w = Wrong { x: 1 };
    let b = w[0];
}
