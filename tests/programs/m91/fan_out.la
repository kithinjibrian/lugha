// Fan out squares to green threads, then join them in order.
fun square(n: i64): i64 = n * n;

fun main() {
    let mut tasks: Task<i64>[] = [];
    for i in 1..6 {
        tasks.push(spawn square(i));
    }
    let mut total = 0;
    for t of tasks {
        total += t.join();
    }
    println(total);
    // Joining again gives the same result again.
    println(tasks[2].join());
}
