// A buffered channel: the producer runs ahead by up to two values, then
// closes the channel; the consumer drains it.
fun produce(out: Chan<string>, count: i64) {
    for i in 0..count {
        out.send("item {i}");
        println("sent {i}");
    }
    out.close();
}

fun main() {
    let c: Chan<string> = Chan.buffered(2);
    spawn produce(c, 5);
    while let Some(item) = c.recv() {
        println("got {item}");
    }
    println("closed: {c.recv()}");
}
