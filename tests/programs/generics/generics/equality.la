struct Point { x: i64, y: i64 }

fun contains<T: Eq>(xs: T[], x: T): bool {
    for y of xs {
        if y == x { return true; }
    }
    false
}

fun largest<T: Ord>(xs: T[]): Option<T> {
    if xs.len == 0 { return None; }
    let mut best = xs[0];
    for x of xs {
        if x > best { best = x; }
    }
    Some(best)
}

struct Pair<A, B> { a: A, b: B }

fun main() {
    let ps = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    println(contains(ps, Point { x: 3, y: 4 }));
    println(contains(ps, Point { x: 4, y: 3 }));
    println(contains([[1], [2, 3]], [2, 3]));
    println(Pair { a: 1, b: "x" } == Pair { a: 1, b: "x" });
    match largest([1.5, 0.5, 2.5]) {
        Some(f) => println(f),
        None => println(0.0),
    }
    match largest(["pear", "apple", "plum"]) {
        Some(w) => println(w),
        None => println("none"),
    }
}
