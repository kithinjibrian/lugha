interface Counter {
    fun bump(mut self, by: i64);
    fun value(self): i64;
}

struct Tally { n: i64 }

impl Tally {
    fun bump(mut self, by: i64) { self.n += by; }
    fun value(self): i64 = self.n;
}

fun bump_all<T: Counter>(xs: T[]): T[] {
    let mut out = xs;
    for i in 0..out.len {
        out[i].bump(10);
    }
    out
}

fun first_equal<T: Counter + Eq>(xs: T[], x: T): i64 {
    for i in 0..xs.len {
        if xs[i] == x { return xs[i].value(); }
    }
    -1
}

fun main() {
    let ts = [Tally { n: 1 }, Tally { n: 2 }];
    let bumped = bump_all(ts);
    println(ts[0].value());
    println(bumped[1].value());
    println(first_equal(bumped, Tally { n: 12 }));
}
