// std.env (v15, milestone 64): read-only environment variables and the
// current directory. `env.envvars` sets the two LUGHA_TEST_ variables.
import std.env;

fun main() {
    println(env.get("LUGHA_TEST_VALUE"));
    println(env.get("LUGHA_TEST_EMPTY"));
    println(env.get("LUGHA_SURELY_UNSET_VARIABLE"));
    println(env.get("BAD\0NAME"));
    match env.current_dir() {
        Ok(dir) => println(dir.starts_with("/")),
        Err(e) => println("error: {e}"),
    }
    let data = env.get("LUGHA_TEST_VALUE").unwrap_or("default");
    println(data.char_count());
}
