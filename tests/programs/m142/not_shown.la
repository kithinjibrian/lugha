// A type that doesn't meet a program's derivable interface: E0451 names
// the path to the part no block covers (v17, milestone 142).
interface Show {
    fun show(self): string;
}

derive Show for i64 {
    fun show(self): string = "{self}";
}

derive<T: Show> Show for T[] {
    fun show(self): string = "[]";
}

derive Show for struct {
    fun show(self): string = "struct";
}

derive Show for enum {
    fun show(self): string = "enum";
}

fun show<T: Show>(x: T): string = x.show();

struct Job { name: i64, run: fun(i64): i64 }

struct Crowd { ages: bool[] }

enum Shape { Dot, Named(string) }

fun loose<T>(x: T): string = show(x);

fun main() {
    let a = show(Job { name: 1, run: fun(x: i64): i64 = x });
    let b = show(Crowd { ages: [true] });
    let c = show(Shape.Dot);
}
