// A float's raw bits and back (v17, milestone 108).
fun main() {
    let x = 1.5;
    let b = x.to_bits();
    println("{b:x}");
    println(f64.from_bits(b));
    println("{(-0.0).to_bits():x}");
    println(f64.from_bits(0x7FF0000000000000));
    println(f64.from_bits(0x7FF8000000000000).to_bits() == 0x7FF8000000000000);
    let h: f32 = 0.1;
    println("{h.to_bits():x}");
    println(f32.from_bits(h.to_bits()) == h);
    let n = f32.from_bits(0x7FC00000);
    println(n != n);
    println("{(1.0 as f32).to_bits():x}");
}
