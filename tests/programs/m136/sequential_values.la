// Big values made one after another in one block share slots only once
// each is finished (PRP-168): values still read later keep theirs.
struct Wide {
    g0: i64,
    g1: i64,
    g2: i64,
    g3: i64,
    g4: i64,
    g5: i64,
    g6: i64,
    g7: i64,
    g8: i64,
    g9: i64,
    g10: i64,
    g11: i64,
    g12: i64,
    g13: i64,
    g14: i64,
    g15: i64,
    g16: i64,
    g17: i64,
    g18: i64,
    g19: i64,
    g20: i64,
    g21: i64,
    g22: i64,
    g23: i64,
    g24: i64,
    g25: i64,
    g26: i64,
    g27: i64,
    g28: i64,
    g29: i64,
    g30: i64,
    g31: i64,
    g32: i64,
    g33: i64,
    g34: i64,
    g35: i64,
    g36: i64,
    g37: i64,
    g38: i64,
    g39: i64,
    g40: i64,
    g41: i64,
    g42: i64,
    g43: i64,
    g44: i64,
    g45: i64,
    g46: i64,
    g47: i64,
    g48: i64,
    g49: i64,
    g50: i64,
    g51: i64,
    g52: i64,
    g53: i64,
    g54: i64,
    g55: i64,
    g56: i64,
    g57: i64,
    g58: i64,
    g59: i64,
    g60: i64,
    g61: i64,
    g62: i64,
    g63: i64,
    g64: i64,
    g65: i64,
    g66: i64,
    g67: i64,
    g68: i64,
    g69: i64,
    g70: i64,
    g71: i64,
    g72: i64,
    g73: i64,
    g74: i64,
    g75: i64,
    g76: i64,
    g77: i64,
    g78: i64,
    g79: i64,
}

fun wide(n: i64): Wide = Wide { g0: n, g79: n * 3, ..zero() };

fun zero(): Wide = Wide {
    g0: 0,
    g1: 0,
    g2: 0,
    g3: 0,
    g4: 0,
    g5: 0,
    g6: 0,
    g7: 0,
    g8: 0,
    g9: 0,
    g10: 0,
    g11: 0,
    g12: 0,
    g13: 0,
    g14: 0,
    g15: 0,
    g16: 0,
    g17: 0,
    g18: 0,
    g19: 0,
    g20: 0,
    g21: 0,
    g22: 0,
    g23: 0,
    g24: 0,
    g25: 0,
    g26: 0,
    g27: 0,
    g28: 0,
    g29: 0,
    g30: 0,
    g31: 0,
    g32: 0,
    g33: 0,
    g34: 0,
    g35: 0,
    g36: 0,
    g37: 0,
    g38: 0,
    g39: 0,
    g40: 0,
    g41: 0,
    g42: 0,
    g43: 0,
    g44: 0,
    g45: 0,
    g46: 0,
    g47: 0,
    g48: 0,
    g49: 0,
    g50: 0,
    g51: 0,
    g52: 0,
    g53: 0,
    g54: 0,
    g55: 0,
    g56: 0,
    g57: 0,
    g58: 0,
    g59: 0,
    g60: 0,
    g61: 0,
    g62: 0,
    g63: 0,
    g64: 0,
    g65: 0,
    g66: 0,
    g67: 0,
    g68: 0,
    g69: 0,
    g70: 0,
    g71: 0,
    g72: 0,
    g73: 0,
    g74: 0,
    g75: 0,
    g76: 0,
    g77: 0,
    g78: 0,
    g79: 0,
};

fun sum(w: Wide): i64 = w.g0 + w.g79;

fun bump(w: Wide): Wide = Wide { g0: w.g0 + 1, ..w };

fun main() {
    // Each finished before the next starts.
    let a = sum(wide(1));
    let b = sum(wide(2));
    let c = sum(bump(wide(3)));
    // Kept until the end, while others come and go.
    let keep = wide(10);
    let d = sum(wide(4));
    let kept2 = bump(keep);
    let e = sum(bump(bump(wide(5))));
    let swapped = if a < b { bump(kept2) } else { keep };
    println("{a} {b} {c} {d} {e}");
    println("{sum(keep)} {sum(kept2)} {sum(swapped)}");
}
