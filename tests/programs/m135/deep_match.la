// A deep recursion through a match whose arms each build a 1 KB value
// (PRP-167): the arms share their stack slots, so 400 levels fit the main
// thread's stack at -O0. With a slot per arm, each frame was ~94 KB.
struct Big {
    g0: i64,
    g1: i64,
    g2: i64,
    g3: i64,
    g4: i64,
    g5: i64,
    g6: i64,
    g7: i64,
    g8: i64,
    g9: i64,
    g10: i64,
    g11: i64,
    g12: i64,
    g13: i64,
    g14: i64,
    g15: i64,
    g16: i64,
    g17: i64,
    g18: i64,
    g19: i64,
    g20: i64,
    g21: i64,
    g22: i64,
    g23: i64,
    g24: i64,
    g25: i64,
    g26: i64,
    g27: i64,
    g28: i64,
    g29: i64,
    g30: i64,
    g31: i64,
    g32: i64,
    g33: i64,
    g34: i64,
    g35: i64,
    g36: i64,
    g37: i64,
    g38: i64,
    g39: i64,
    g40: i64,
    g41: i64,
    g42: i64,
    g43: i64,
    g44: i64,
    g45: i64,
    g46: i64,
    g47: i64,
    g48: i64,
    g49: i64,
    g50: i64,
    g51: i64,
    g52: i64,
    g53: i64,
    g54: i64,
    g55: i64,
    g56: i64,
    g57: i64,
    g58: i64,
    g59: i64,
    g60: i64,
    g61: i64,
    g62: i64,
    g63: i64,
    g64: i64,
    g65: i64,
    g66: i64,
    g67: i64,
    g68: i64,
    g69: i64,
    g70: i64,
    g71: i64,
    g72: i64,
    g73: i64,
    g74: i64,
    g75: i64,
    g76: i64,
    g77: i64,
    g78: i64,
    g79: i64,
    g80: i64,
    g81: i64,
    g82: i64,
    g83: i64,
    g84: i64,
    g85: i64,
    g86: i64,
    g87: i64,
    g88: i64,
    g89: i64,
    g90: i64,
    g91: i64,
    g92: i64,
    g93: i64,
    g94: i64,
    g95: i64,
    g96: i64,
    g97: i64,
    g98: i64,
    g99: i64,
    g100: i64,
    g101: i64,
    g102: i64,
    g103: i64,
    g104: i64,
    g105: i64,
    g106: i64,
    g107: i64,
    g108: i64,
    g109: i64,
    g110: i64,
    g111: i64,
    g112: i64,
    g113: i64,
    g114: i64,
    g115: i64,
    g116: i64,
    g117: i64,
    g118: i64,
    g119: i64,
    g120: i64,
    g121: i64,
    g122: i64,
    g123: i64,
    g124: i64,
    g125: i64,
    g126: i64,
    g127: i64,
}

enum V {
    Leaf,
    A0(V, Big),
    A1(V, Big),
    A2(V, Big),
    A3(V, Big),
    A4(V, Big),
    A5(V, Big),
    A6(V, Big),
    A7(V, Big),
    A8(V, Big),
    A9(V, Big),
    A10(V, Big),
    A11(V, Big),
}

fun big(n: i64): Big = Big { g0: n, g1: n, g2: n, g3: n, g4: n, g5: n, g6: n, g7: n, g8: n, g9: n, g10: n, g11: n, g12: n, g13: n, g14: n, g15: n, g16: n, g17: n, g18: n, g19: n, g20: n, g21: n, g22: n, g23: n, g24: n, g25: n, g26: n, g27: n, g28: n, g29: n, g30: n, g31: n, g32: n, g33: n, g34: n, g35: n, g36: n, g37: n, g38: n, g39: n, g40: n, g41: n, g42: n, g43: n, g44: n, g45: n, g46: n, g47: n, g48: n, g49: n, g50: n, g51: n, g52: n, g53: n, g54: n, g55: n, g56: n, g57: n, g58: n, g59: n, g60: n, g61: n, g62: n, g63: n, g64: n, g65: n, g66: n, g67: n, g68: n, g69: n, g70: n, g71: n, g72: n, g73: n, g74: n, g75: n, g76: n, g77: n, g78: n, g79: n, g80: n, g81: n, g82: n, g83: n, g84: n, g85: n, g86: n, g87: n, g88: n, g89: n, g90: n, g91: n, g92: n, g93: n, g94: n, g95: n, g96: n, g97: n, g98: n, g99: n, g100: n, g101: n, g102: n, g103: n, g104: n, g105: n, g106: n, g107: n, g108: n, g109: n, g110: n, g111: n, g112: n, g113: n, g114: n, g115: n, g116: n, g117: n, g118: n, g119: n, g120: n, g121: n, g122: n, g123: n, g124: n, g125: n, g126: n, g127: n };

fun build(n: i64): V = if n == 0 {
    V.Leaf
} else {
    match n % 12 {
        0 => V.A0(build(n - 1), big(n)),
        1 => V.A1(build(n - 1), big(n)),
        2 => V.A2(build(n - 1), big(n)),
        3 => V.A3(build(n - 1), big(n)),
        4 => V.A4(build(n - 1), big(n)),
        5 => V.A5(build(n - 1), big(n)),
        6 => V.A6(build(n - 1), big(n)),
        7 => V.A7(build(n - 1), big(n)),
        8 => V.A8(build(n - 1), big(n)),
        9 => V.A9(build(n - 1), big(n)),
        10 => V.A10(build(n - 1), big(n)),
        11 => V.A11(build(n - 1), big(n)),
        _ => V.Leaf,
    }
};

fun walk(v: V): V = match v {
    A0(x, b) => V.A1(walk(x), b),
    A1(x, b) => V.A2(walk(x), b),
    A2(x, b) => V.A3(walk(x), b),
    A3(x, b) => V.A4(walk(x), b),
    A4(x, b) => V.A5(walk(x), b),
    A5(x, b) => V.A6(walk(x), b),
    A6(x, b) => V.A7(walk(x), b),
    A7(x, b) => V.A8(walk(x), b),
    A8(x, b) => V.A9(walk(x), b),
    A9(x, b) => V.A10(walk(x), b),
    A10(x, b) => V.A11(walk(x), b),
    A11(x, b) => V.A0(walk(x), b),
    _ => v,
};

fun sum(v: V): i64 = match v {
    A0(x, b) => sum(x) + b.g0 + b.g127,
    A1(x, b) => sum(x) + b.g0 + b.g127,
    A2(x, b) => sum(x) + b.g0 + b.g127,
    A3(x, b) => sum(x) + b.g0 + b.g127,
    A4(x, b) => sum(x) + b.g0 + b.g127,
    A5(x, b) => sum(x) + b.g0 + b.g127,
    A6(x, b) => sum(x) + b.g0 + b.g127,
    A7(x, b) => sum(x) + b.g0 + b.g127,
    A8(x, b) => sum(x) + b.g0 + b.g127,
    A9(x, b) => sum(x) + b.g0 + b.g127,
    A10(x, b) => sum(x) + b.g0 + b.g127,
    A11(x, b) => sum(x) + b.g0 + b.g127,
    _ => 0,
};

fun tag(v: V): i64 = match v {
    A0(_, _) => 0,
    A1(_, _) => 1,
    A2(_, _) => 2,
    A3(_, _) => 3,
    A4(_, _) => 4,
    A5(_, _) => 5,
    A6(_, _) => 6,
    A7(_, _) => 7,
    A8(_, _) => 8,
    A9(_, _) => 9,
    A10(_, _) => 10,
    A11(_, _) => 11,
    _ => -1,
};

fun main() {
    let v = build(400);
    println(sum(v));
    let w = walk(v);
    println(sum(w));
    println("{tag(v)} {tag(w)}");
}
