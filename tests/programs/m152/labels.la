// Labels on every kind of loop: `break` and `continue` reach the one named.
fun main() {
    let mut found = 0;
    rows: for r in 0..5 {
        let mut c = 0;
        cols: while c < 5 {
            c += 1;
            if c == 2 {
                continue cols;
            }
            if r * c == 6 {
                found = r * 10 + c;
                break rows;
            }
        }
    }
    println(found);

    let mut it = [5, 6, 7, 8].iter();
    let mut seen = 0;
    items: while let Some(x) = it.next() {
        for d in 0..x {
            if d == 1 {
                seen += 1;
                continue items;
            }
        }
    }
    println(seen);

    let mut count = 0;
    outer: loop {
        inner: loop {
            count += 1;
            if count < 3 {
                continue inner;
            }
            if count < 5 {
                continue outer;
            }
            break outer;
        }
    }
    println(count);
}
