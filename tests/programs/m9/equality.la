// Deep == and string order (PRP-031, v2 milestone 9).
struct Item { name: string, tags: string[], counts: i64[][], ok: bool }

enum Shape { Circle(f64), Rect(f64, f64), Empty }

enum List { Nil, Cons(i64, List) }

fun list(n: i64): List {
    let mut l = List.Nil;
    for i in 0..n { l = List.Cons(i, l); }
    l
}

fun main() {
    // Structs: field by field, through arrays and strings.
    let a = Item { name: "x", tags: ["t", "u"], counts: [[1, 2], [3]], ok: true };
    let mut b = a;
    println(a == b);
    b.counts[1].push(4);
    println(a == b);
    println(a != b);
    let mut c = a;
    c.ok = false;
    println(a == c);

    // Arrays: length, then elements.
    println([[1, 2], [3]] == [[1, 2], [3]]);
    println([1, 2] == [1, 2, 3]);
    println([1, 2] == [1, 3]);
    let empty: i64[] = [];
    println(empty == []);

    // Enums: variant, then payloads; recursive ones too.
    println(Shape.Rect(1.0, 2.0) == Shape.Rect(1.0, 2.0));
    println(Shape.Rect(1.0, 2.0) == Shape.Rect(2.0, 1.0));
    println(Shape.Circle(1.0) == Shape.Empty);
    println(Shape.Empty == Shape.Empty);
    println(list(5) == list(5));
    println(list(5) == list(4));

    // Option, from either side.
    let o: Option<string> = Some("a");
    println(o == None);
    println(None == o);
    println(o == Some("a"));

    // NaN is unequal to itself, even inside an array.
    let nan = 0.0 / 0.0;
    let xs = [1.0, nan];
    println(xs == xs);
    println(xs != xs);

    // Strings order bytewise; a prefix is smaller; bytes are unsigned.
    println("ab" < "abc");
    println("abc" < "ab");
    println("b" > "abc");
    println("a" <= "a");
    println("é" > "z");
    println("Z" < "a");
}
