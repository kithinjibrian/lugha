// Parsing and UTF-8 decoding (v15, milestone 62: written in Lugha over one
// decoder). The expected output is the C implementation's (milestone 61).
fun show_i64(s: string): string = match parse_i64(s) {
    Some(n) => "{n}",
    None => "none",
};

fun show_u64(s: string): string = match parse_u64(s) {
    Some(n) => "{n}",
    None => "none",
};

// 'V' for valid bytes, else the first bad byte's index.
fun verdict(bytes: u8[]): string = match string_from_utf8(bytes) {
    Ok(_) => "V",
    Err(e) => e.slice(e.len - 1, e.len),
};

fun main() {
    let cases = ["0", "-0", "7", "-7", "007", "", "-", "+1", " 1", "1 ", "1a", "--1",
        "9223372036854775807", "9223372036854775808", "-9223372036854775808",
        "-9223372036854775809", "18446744073709551615", "18446744073709551616",
        "99999999999999999999", "١٢"];
    for c of cases {
        println("[{c}] {show_i64(c)} {show_u64(c)}");
    }
    // Every two-byte input, one line per first byte.
    for b0 in 0..256 {
        let mut line = "";
        for b1 in 0..256 {
            line = line + verdict([b0 as u8, b1 as u8]);
        }
        println("{b0}: {line}");
    }
    // Chosen longer sequences: valid, overlong, surrogate, too high, truncated.
    let seqs: u8[][] = [
        [226, 130, 172], [224, 128, 128], [224, 160, 128], [237, 159, 191], [237, 160, 128],
        [239, 191, 191], [240, 144, 128, 128], [240, 128, 128, 128], [244, 143, 191, 191],
        [244, 144, 128, 128], [245, 128, 128, 128], [226, 130], [240, 159, 152],
        [97, 226, 130, 172, 98], [97, 128, 98], [195, 169, 0, 226, 130, 172],
    ];
    for s of seqs {
        match string_from_utf8(s) {
            Ok(text) => {
                let mut codes = "";
                for c of text.chars() {
                    codes = codes + " {c as u32}";
                }
                println("ok{codes} ({text.char_count()})");
            }
            Err(e) => println(e),
        }
    }
}
