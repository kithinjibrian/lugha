// Loops that own their arrays once (v15, milestone 56): each array was
// copied before the loop, so the loop's first write must still copy it.
struct Grid { cells: f64[][] }

fun mul(a: f64[][], b: f64[][]): f64[][] {
    let n = a.len;
    let mut out = [[0.0; n]; n];
    let before = out;
    for i in 0..n {
        for k in 0..n {
            let aik = a[i][k];
            for j in 0..n {
                out[i][j] += aik * b[k][j];
            }
        }
    }
    println("{before}");
    out
}

fun main() {
    // A histogram over a copied array.
    let mut counts = [0; 4];
    let saved = counts;
    let text = [1, 3, 1, 2, 1];
    for r in 0..3 {
        for i in 0..text.len {
            counts[text[i]] += 1;
        }
    }
    println("{counts} {saved}");

    // A matrix product whose result starts as a shared copy.
    let m = [[1.0, 2.0], [3.0, 4.0]];
    println("{mul(m, m)} {m}");

    // Fields, `while`, `push` and `for … of mut`.
    let mut g = Grid { cells: [[0.0; 2]; 2] };
    let old = g;
    let mut k = 0;
    while k < 2 {
        g.cells[k][1] = k as f64;
        g.cells[0].push(9.0);
        k += 1;
    }
    for row of mut g.cells {
        row[0] += 5.0;
    }
    println("{g.cells} {old.cells}");

    // `while let` and an index fixed across the inner loop.
    let mut rows = [[1, 1], [2, 2]];
    let copy = rows;
    let mut next = Some(1);
    while let Some(r) = next {
        for j in 0..2 {
            rows[r][j] *= 10;
        }
        next = None;
    }
    println("{rows} {copy}");
}
