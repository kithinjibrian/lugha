// A type that isn't `Eq` (v17, milestone 144): E0451 names the part, at
// `==` and at a `T: Eq` bound alike.
struct Job { id: i64, run: fun(i64): i64 }
struct Shelf { jobs: Job[] }
enum Slot { Empty, Holding(Job) }

fun same<T: Eq>(a: T, b: T): bool = a == b;

fun main() {
    let j = Job { id: 1, run: fun(x: i64): i64 = x };
    let a = j == j;
    let b = same(Shelf { jobs: [j] }, Shelf { jobs: [] });
    let c = Slot.Holding(j) != Slot.Empty;
}
