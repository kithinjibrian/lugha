// Enums, Option and match (PRP-020).
struct Pt { x: i64, y: i64 }

enum Value {
    Int(i64),
    Small(u8, i32),
    Real(f64),
    Flag(bool),
    Text(string),
    Point(Pt),
    Nothing,
}

enum Light { Red, Amber, Green }

fun describe(v: Value): string = match v {
    Int(n) => "int " + to_string(n),
    Small(b, i) => "small " + to_string(b) + " " + to_string(i),
    Real(r) => "real " + to_string(r),
    Flag(f) => "flag " + to_string(f),
    Text(t) => "text " + t,
    Point(p) => "point " + to_string(p.x + p.y),
    Nothing => "nothing",
};

fun find(xs: i64[], target: i64): Option<i64> {
    for i in 0..xs.len {
        if xs[i] == target {
            return Some(i);
        }
    }
    None
}

struct Car { name: string, light: Light }

fun next(l: Light): Light = match l {
    Red => Light.Green,
    Green => Light.Amber,
    Amber => Light.Red,
};

fun main() {
    let values = [
        Value.Int(-4),
        Value.Small(200, -7),
        Value.Real(2.5),
        Value.Flag(true),
        Value.Text("hi"),
        Value.Point(Pt { x: 3, y: 4 }),
        Value.Nothing,
    ];
    for v of values {
        println(describe(v));
    }

    match find([5, 7, 9], 9) {
        Some(i) => println(i),
        None => println("missing"),
    }
    let missing = find([5, 7, 9], 4);
    let shown = match missing {
        Some(_) => "found",
        None => "not found",
    };
    println(shown);

    let code = 404;
    let text = match code {
        200 => "ok",
        404 => "not found",
        _ => "other",
    };
    println(text);

    let word = "two";
    match word {
        "one" => println(1),
        "two" => println(2),
        _ => println(0),
    }

    let ok = 3 > 2;
    println(match ok { true => "yes", false => "no" });

    let mut car = Car { name: "c", light: Light.Red };
    car.light = next(car.light);
    car.light = next(car.light);
    match car.light {
        Amber => println(car.name + " amber"),
        _ => println("?"),
    }
}
