// Struct update syntax (v17, milestone 93): the fields not written come
// from `..base`, evaluated once, after the written fields.
struct Model { count: i64, name: string, items: string[] }

enum Msg { Add, Named(string), Clear }

fun update(m: Model, msg: Msg): Model = match msg {
    Add => Model { count: m.count + 1, ..m },
    Named(n) => Model { name: n, ..m },
    Clear => Model { items: [], count: 0, ..m },
};

fun noisy(label: string, v: i64): i64 {
    println(label);
    v
}

fun base(): Model {
    println("base");
    Model { count: 0, name: "b", items: [] }
}

struct Pair<A, B> { a: A, b: B }

struct Inner { x: i64, y: i64 }
struct Outer { inner: Inner, tag: string }

fun main() {
    let m = Model { count: 0, name: "", items: ["a", "b"] };
    let m = update(m, Msg.Add);
    let m = update(m, Msg.Named("ada"));
    println("{m.count} {m.name} {m.items}");
    let cleared = update(m, Msg.Clear);
    println("{cleared.count} {cleared.name} {cleared.items} / {m.items}");

    // Written fields first, then the base, once.
    let o = Model { count: noisy("count", 5), ..base() };
    println(o.count);

    // Copies: changing the copy's array leaves the base's alone.
    let mut copy = Model { count: 9, ..m };
    copy.items.push("c");
    println("{copy.items} {m.items}");

    // Generic: the base fixes the type arguments.
    let p = Pair { a: 1, b: "one" };
    let q = Pair { a: 2, ..p };
    println("{q.a} {q.b}");

    // Nested.
    let out = Outer { inner: Inner { x: 1, y: 2 }, tag: "t" };
    let moved = Outer { inner: Inner { x: 10, ..out.inner }, ..out };
    println("{moved.inner.x} {moved.inner.y} {moved.tag}");
}
