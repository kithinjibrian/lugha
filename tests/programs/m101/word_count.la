// Maps (v17, milestone 101): counting words, in insertion order.
fun main() {
    let text = "the cat and the hat and the bat";
    let mut counts: Map<string, i64> = #{};
    for w of text.split(" ") {
        counts[w] = counts.get(w).unwrap_or(0) + 1;
    }
    println(counts);
    println(counts["the"]);
    println(counts.len);
    for (w, n) of counts {
        if n > 1 {
            println("{w}: {n}");
        }
    }
}
