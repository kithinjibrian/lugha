/**
 * std.$json_from: the Lugha half of `json.decode` (v17, milestone 140).
 * The compiler writes each struct's, enum's and tuple's walker and calls
 * these for everything else; `$json.decode(v, path)` here is that walker
 * again, at the type the context wants. Bundled sources only; see `std.json`.
 */
import std.$json_value { DecodeError, Value };

fun $kind(v: Value): string = match v {
    Null => "null",
    Bool(_) => "a boolean",
    Integer(_) => "an integer",
    Float(_) => "a float",
    Text(_) => "a string",
    Array(_) => "an array",
    Object(_) => "an object",
};

fun $fail<T>(path: string, detail: string): Result<T, DecodeError> = Err(DecodeError { path: path, detail: detail });

fun $wrong<T>(path: string, wanted: string, v: Value): Result<T, DecodeError> = $fail(path, "expected {wanted}, found {$kind(v)}");

fun $field_path(path: string, name: string): string = if path.len == 0 { name } else { "{path}.{name}" };

fun $index_path(path: string, i: i64): string = "{path}[{i}]";

fun $dec_int(v: Value, path: string, min: i64, max: i64, name: string): Result<i64, DecodeError> = match v {
    Integer(n) => if n < min || n > max { $fail(path, "{n} doesn't fit {name}") } else { Ok(n) },
    _ => $wrong(path, "an integer", v),
};

fun $dec_i8(v: Value, path: string): Result<i8, DecodeError> = $dec_int(v, path, -128, 127, "i8").map(fun(n) = n as i8);

fun $dec_i16(v: Value, path: string): Result<i16, DecodeError> = $dec_int(v, path, -32768, 32767, "i16").map(fun(n) = n as i16);

fun $dec_i32(v: Value, path: string): Result<i32, DecodeError> = $dec_int(v, path, -2147483648, 2147483647, "i32").map(fun(n) = n as i32);

fun $dec_i64(v: Value, path: string): Result<i64, DecodeError> = $dec_int(v, path, i64.MIN, i64.MAX, "i64");

fun $dec_u8(v: Value, path: string): Result<u8, DecodeError> = $dec_int(v, path, 0, 255, "u8").map(fun(n) = n as u8);

fun $dec_u16(v: Value, path: string): Result<u16, DecodeError> = $dec_int(v, path, 0, 65535, "u16").map(fun(n) = n as u16);

fun $dec_u32(v: Value, path: string): Result<u32, DecodeError> = $dec_int(v, path, 0, 4294967295, "u32").map(fun(n) = n as u32);

fun $dec_u64(v: Value, path: string): Result<u64, DecodeError> = $dec_int(v, path, 0, i64.MAX, "u64").map(fun(n) = n as u64);

fun $dec_f64(v: Value, path: string): Result<f64, DecodeError> = match v {
    Integer(n) => Ok(n as f64),
    Float(x) => Ok(x),
    _ => $wrong(path, "a number", v),
};

fun $dec_f32(v: Value, path: string): Result<f32, DecodeError> = $dec_f64(v, path).map(fun(x) = x as f32);

fun $dec_bool(v: Value, path: string): Result<bool, DecodeError> = match v {
    Bool(b) => Ok(b),
    _ => $wrong(path, "a boolean", v),
};

fun $dec_text(v: Value, path: string): Result<string, DecodeError> = match v {
    Text(s) => Ok(s),
    _ => $wrong(path, "a string", v),
};

fun $dec_char(v: Value, path: string): Result<char, DecodeError> {
    let s = $dec_text(v, path)?;
    let mut found: Option<char> = None;
    let mut count = 0;
    for c of s.chars() {
        found = Some(c);
        count += 1;
    }
    match found {
        Some(c) if count == 1 => Ok(c),
        _ => $fail(path, "expected one character, found \"{s}\""),
    }
}

fun $dec_unit(v: Value, path: string): Result<(), DecodeError> = match v {
    Null => Ok(()),
    _ => $wrong(path, "null", v),
};

fun $dec_value(v: Value, path: string): Result<Value, DecodeError> = Ok(v);

fun $dec_array<T>(v: Value, path: string): Result<T[], DecodeError> {
    let xs = match v {
        Array(xs) => xs,
        _ => {
            return $wrong(path, "an array", v);
        }
    };
    let mut out: T[] = [];
    for i in 0..xs.len {
        let r: Result<T, DecodeError> = $json.decode(xs[i], $index_path(path, i));
        out.push(r?);
    }
    Ok(out)
}

fun $dec_option<T>(v: Value, path: string): Result<Option<T>, DecodeError> {
    if let Null = v {
        return Ok(None);
    }
    let r: Result<T, DecodeError> = $json.decode(v, path);
    Ok(Some(r?))
}

/** An array with no element twice. */
fun $dec_set<T: Eq>(v: Value, path: string): Result<Set<T>, DecodeError> {
    let xs = $dec_items(v, -1, path)?;
    let mut out: Set<T> = #{};
    for i in 0..xs.len {
        let r: Result<T, DecodeError> = $json.decode(xs[i], $index_path(path, i));
        if !out.insert(r?) {
            return $fail($index_path(path, i), "a repeated element");
        }
    }
    Ok(out)
}

/** An object; keys decode as `K` from their text, or for an integer `K` as the integer they spell. */
fun $dec_map<K: Eq, V>(v: Value, path: string): Result<Map<K, V>, DecodeError> {
    let m = $dec_object(v, path)?;
    let mut out: Map<K, V> = #{};
    for (k, x) of m {
        let at = "{path}[\"{k}\"]";
        let as_text: Result<K, DecodeError> = $json.decode(Value.Text(k), at);
        let key = match as_text {
            Ok(key) => key,
            Err(_) => {
                let as_number: Result<K, DecodeError> = $json.decode($key_number(k, at)?, at);
                as_number?
            }
        };
        let r: Result<V, DecodeError> = $json.decode(x, at);
        out.insert(key, r?);
    }
    Ok(out)
}

fun $key_number(k: string, at: string): Result<Value, DecodeError> = match parse_i64(k) {
    Some(n) => Ok(Value.Integer(n)),
    None => $fail(at, "a key that isn't an integer"),
};

fun $dec_object(v: Value, path: string): Result<Map<string, Value>, DecodeError> = match v {
    Object(m) => Ok(m),
    _ => $wrong(path, "an object", v),
};

/** A struct's field: missing is `null` for an `Option` field, an error otherwise. */
fun $dec_field(m: Map<string, Value>, name: string, path: string, optional: bool): Result<Value, DecodeError> = match m.get(name) {
    Some(x) => Ok(x),
    None => if optional { Ok(Value.Null) } else { $fail(path, "missing field {name}") },
};

/** An array of exactly `n` values (any number when `n` is -1). */
fun $dec_items(v: Value, n: i64, path: string): Result<Value[], DecodeError> = match v {
    Array(xs) => if n < 0 || xs.len == n { Ok(xs) } else { $fail(path, "expected an array of {n}, found {xs.len}") },
    _ => $wrong(path, "an array", v),
};

/** A variant's name: a string, or an object's one key. */
fun $variant_name(v: Value, path: string): Result<string, DecodeError> {
    match v {
        Text(s) => {
            return Ok(s);
        }
        Object(m) if m.len == 1 => {
            return Ok(m.keys()[0]);
        }
        _ => {}
    }
    $fail(path, "expected a variant: a name, or an object with one key")
}

/** The payload of a one-key object (`null` for a bare name). */
fun $variant_payload(v: Value): Value = match v {
    Object(m) => m.values()[0],
    _ => Value.Null,
};

fun $variant_bare(v: Value): bool = match v {
    Text(_) => true,
    _ => false,
};

/** A variant named without the payload it needs, or with one it doesn't take. */
fun $payload_error(path: string, name: string, bare: bool): DecodeError = DecodeError {
    path: $field_path(path, name),
    detail: if bare { "needs a payload" } else { "takes no payload" },
};

fun $unknown_variant(path: string, name: string): DecodeError = DecodeError { path: path, detail: "unknown variant {name}" };
