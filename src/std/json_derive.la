/**
 * std.$json_derive: the Lugha half of `json.encode` (v17, milestone 139).
 * The compiler writes each struct's, enum's and tuple's walker and calls
 * these for everything else; `$json.encode(x)` here is that walker again,
 * at the element's type. Bundled sources only; see `std.json`.
 */
import std.$json_value { Value };

fun $int(n: i64): Value = Value.Integer(n);

/** A `u64` past `i64.MAX` can only be a (rounded) `Float`. */
fun $u64(n: u64): Value = if n > 9223372036854775807 { Value.Float(n as f64) } else { Value.Integer(n as i64) };

fun $float(x: f64): Value = Value.Float(x);

fun $bool(b: bool): Value = Value.Bool(b);

fun $char(c: char): Value = Value.Text("{c}");

fun $text(s: string): Value = Value.Text(s);

fun $null(): Value = Value.Null;

fun $array(xs: Value[]): Value = Value.Array(xs);

/** An object of `keys[i]: values[i]`, in order. */
fun $object(keys: string[], values: Value[]): Value {
    let mut m: Map<string, Value> = #{};
    for i in 0..keys.len {
        m.insert(keys[i], values[i]);
    }
    Value.Object(m)
}

fun $enc_array<T>(xs: T[]): Value {
    let mut out: Value[] = [];
    for x of xs {
        out.push($json.encode(x));
    }
    Value.Array(out)
}

fun $enc_option<T>(o: Option<T>): Value = match o {
    Some(x) => $json.encode(x),
    None => Value.Null,
};

/** Keys as text: a string as it is, an integer in decimal. */
fun $enc_map<K: Eq, V>(m: Map<K, V>): Value {
    let mut out: Map<string, Value> = #{};
    for (k, v) of m {
        out.insert("{k}", $json.encode(v));
    }
    Value.Object(out)
}

fun $enc_set<T: Eq>(s: Set<T>): Value {
    let mut out: Value[] = [];
    for x of s {
        out.push($json.encode(x));
    }
    Value.Array(out)
}
