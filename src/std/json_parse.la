/**
 * std.$json_parse: strict RFC 8259 parsing (v17) — a hand-written scanner
 * over the text's bytes with one position, recursing only into arrays and
 * objects, never deeper than the depth limit. Bundled sources only; see
 * `std.json`.
 */
import std.$json_value { ErrorKind, JsonError, Limits, Oops, Value, oops };

struct Parser {
    b: u8[],
    pos: i64,
    limits: Limits,
    values: i64,
}

/** The value `text` holds, or the first mistake in it. */
fun parse_text(text: string, limits: Limits): Result<Value, JsonError> {
    let b = text.to_bytes();
    // Checked before anything is scanned, so an oversized text costs nothing.
    if b.len > limits.bytes {
        return Err(JsonError { kind: ErrorKind.Limit, detail: "a text larger than {limits.bytes} bytes", line: 1, column: 1 });
    }
    let mut p = Parser { b: b, pos: 0, limits: limits, values: 0 };
    match p.document() {
        Ok(v) => Ok(v),
        Err(o) => Err(locate(b, o)),
    }
}

/** `o` with the line and column of its byte (columns count characters). */
fun locate(b: u8[], o: Oops): JsonError {
    let mut line = 1;
    let mut column = 1;
    let end = if o.at < b.len { o.at } else { b.len };
    for k in 0..end {
        if b[k] == 10 {
            line += 1;
            column = 1;
        } else if b[k] < 128 || b[k] >= 192 {
            // Continuation bytes (10xxxxxx) belong to the character before.
            column += 1;
        }
    }
    JsonError { kind: o.kind, detail: o.detail, line: line, column: column }
}

fun at(b: u8[], i: i64): u8 = if i >= 0 && i < b.len { b[i] } else { 0 };

fun digit(c: u8): bool = c >= 48 && c <= 57;

fun syntax(detail: string, i: i64): Oops = oops(ErrorKind.Syntax, detail, i);

fun text(bytes: u8[]): string = string_from_utf8(bytes).unwrap_or("");

fun cut(b: u8[], from: i64, to: i64): u8[] {
    let mut out: u8[] = [];
    for k in from..to {
        out.push(b[k]);
    }
    out
}

/** The value of a hex digit, or -1. */
fun hex_digit(c: u8): i64 {
    if digit(c) {
        (c - 48) as i64
    } else if c >= 97 && c <= 102 {
        (c - 87) as i64
    } else if c >= 65 && c <= 70 {
        (c - 55) as i64
    } else {
        -1
    }
}

/** The four hex digits at `k`, or -1. */
fun hex4(b: u8[], k: i64): i64 {
    let mut code = 0;
    for j in 0..4 {
        let d = hex_digit(at(b, k + j));
        if d < 0 {
            return -1;
        }
        code = code * 16 + d;
    }
    code
}

/** `out` with `code`'s UTF-8 bytes appended. */
fun encode(code: i64, out: u8[]): u8[] {
    let mut out = out;
    if code < 128 {
        out.push(code as u8);
    } else if code < 2048 {
        out.push((192 + code / 64) as u8);
        out.push((128 + code % 64) as u8);
    } else if code < 65536 {
        out.push((224 + code / 4096) as u8);
        out.push((128 + code / 64 % 64) as u8);
        out.push((128 + code % 64) as u8);
    } else {
        out.push((240 + code / 262144) as u8);
        out.push((128 + code / 4096 % 64) as u8);
        out.push((128 + code / 64 % 64) as u8);
        out.push((128 + code % 64) as u8);
    }
    out
}

/** An escape at `i` (its backslash), appended to `out`; the position after it. */
fun escape(b: u8[], i: i64, out: u8[]): Result<(u8[], i64), Oops> {
    let mut out = out;
    let simple = match at(b, i + 1) {
        34 => 34,
        92 => 92,
        47 => 47,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        _ => 0,
    };
    if simple != 0 {
        out.push(simple as u8);
        return Ok((out, i + 2));
    }
    if at(b, i + 1) != 117 {
        return Err(oops(ErrorKind.BadValue, "an unknown escape", i));
    }
    let high = hex4(b, i + 2);
    if high < 0 {
        return Err(oops(ErrorKind.BadValue, "a \\u escape needs 4 hex digits", i));
    }
    if high < 55296 || high > 57343 {
        return Ok((encode(high, out), i + 6));
    }
    // A surrogate: only a high one (D800–DBFF) directly followed by an
    // escaped low one (DC00–DFFF) makes a character.
    if high <= 56319 && at(b, i + 6) == 92 && at(b, i + 7) == 117 {
        let low = hex4(b, i + 8);
        if low >= 56320 && low <= 57343 {
            return Ok((encode(65536 + (high - 55296) * 1024 + (low - 56320), out), i + 12));
        }
    }
    Err(oops(ErrorKind.BadValue, "a lone surrogate: {text(cut(b, i, i + 6))}", i))
}

/** Whether `x` is neither NaN nor an infinity (both make `x - x` NaN). */
fun finite(x: f64): bool = x - x == 0.0;

impl Parser {
    fun document(mut self): Result<Value, Oops> {
        if at(self.b, 0) == 239 && at(self.b, 1) == 187 && at(self.b, 2) == 191 {
            return Err(syntax("a byte-order mark", 0));
        }
        self.skip_ws();
        let v = self.value(0)?;
        self.skip_ws();
        if self.pos < self.b.len {
            return Err(syntax("expected the end of the text", self.pos));
        }
        Ok(v)
    }

    /** Only RFC 8259's four whitespace bytes. */
    fun skip_ws(mut self) {
        while self.pos < self.b.len {
            let c = self.b[self.pos];
            if c != 32 && c != 9 && c != 10 && c != 13 {
                return;
            }
            self.pos += 1;
        }
    }

    /** A value at `pos`, inside `depth` arrays and objects. */
    fun value(mut self, depth: i64): Result<Value, Oops> {
        let start = self.pos;
        let c = at(self.b, start);
        let known = c == 91 || c == 123 || c == 34 || c == 45 || digit(c) || c == 116 || c == 102 || c == 110;
        if !known {
            return Err(syntax("expected a value", start));
        }
        self.values += 1;
        if self.values > self.limits.values {
            return Err(oops(ErrorKind.Limit, "more than {self.limits.values} values", start));
        }
        if c == 91 {
            return self.array(depth + 1);
        }
        if c == 123 {
            return self.object(depth + 1);
        }
        if c == 34 {
            return Ok(Value.Text(self.text_value()?));
        }
        if c == 45 || digit(c) {
            return self.number();
        }
        if self.word("true") {
            return Ok(Value.Bool(true));
        }
        if self.word("false") {
            return Ok(Value.Bool(false));
        }
        if self.word("null") {
            return Ok(Value.Null);
        }
        Err(syntax("expected a value", start))
    }

    /** Whether `w` is next; if so, it's consumed. */
    fun word(mut self, w: string): bool {
        let wb = w.to_bytes();
        for k in 0..wb.len {
            if at(self.b, self.pos + k) != wb[k] {
                return false;
            }
        }
        self.pos += wb.len;
        true
    }

    fun deeper(self, depth: i64): Result<(), Oops> {
        if depth > self.limits.depth {
            return Err(oops(ErrorKind.Limit, "nesting deeper than {self.limits.depth}", self.pos));
        }
        Ok(())
    }

    fun array(mut self, depth: i64): Result<Value, Oops> {
        self.deeper(depth)?;
        self.pos += 1;
        let mut items: Value[] = [];
        self.skip_ws();
        if at(self.b, self.pos) == 93 {
            self.pos += 1;
            return Ok(Value.Array(items));
        }
        while true {
            self.skip_ws();
            items.push(self.value(depth)?);
            self.skip_ws();
            let c = at(self.b, self.pos);
            if c == 93 {
                self.pos += 1;
                return Ok(Value.Array(items));
            }
            if c != 44 {
                return Err(syntax("expected ',' or ']'", self.pos));
            }
            self.pos += 1;
        }
        panic("unreachable");
    }

    fun object(mut self, depth: i64): Result<Value, Oops> {
        self.deeper(depth)?;
        self.pos += 1;
        let mut members: Map<string, Value> = #{};
        self.skip_ws();
        if at(self.b, self.pos) == 125 {
            self.pos += 1;
            return Ok(Value.Object(members));
        }
        while true {
            self.skip_ws();
            let key_at = self.pos;
            if at(self.b, key_at) != 34 {
                return Err(syntax("expected a key", key_at));
            }
            let key = self.text_value()?;
            // Refused rather than last-wins: parsers that disagree on
            // duplicates let one text mean two things (PRP-169, decision 332).
            if members.has(key) {
                return Err(oops(ErrorKind.Duplicate, "a key defined twice: {key}", key_at));
            }
            self.skip_ws();
            if at(self.b, self.pos) != 58 {
                return Err(syntax("expected ':' after a key", self.pos));
            }
            self.pos += 1;
            self.skip_ws();
            members.insert(key, self.value(depth)?);
            self.skip_ws();
            let c = at(self.b, self.pos);
            if c == 125 {
                self.pos += 1;
                return Ok(Value.Object(members));
            }
            if c != 44 {
                return Err(syntax("expected ',' or '}}'", self.pos));
            }
            self.pos += 1;
        }
        panic("unreachable");
    }

    /** A string at `pos` (its opening quote). */
    fun text_value(mut self): Result<string, Oops> {
        let start = self.pos;
        self.pos += 1;
        let mut out: u8[] = [];
        while true {
            if self.pos >= self.b.len {
                return Err(syntax("an unterminated string", start));
            }
            let c = self.b[self.pos];
            if c == 34 {
                self.pos += 1;
                return Ok(text(out));
            }
            if c == 92 {
                let (more, next) = escape(self.b, self.pos, out)?;
                out = more;
                self.pos = next;
            } else if c < 32 {
                return Err(syntax("a control character in a string", self.pos));
            } else {
                out.push(c);
                self.pos += 1;
            }
        }
        panic("unreachable");
    }

    /** A number at `pos`: `Integer` when it has no fraction or exponent and fits. */
    fun number(mut self): Result<Value, Oops> {
        let start = self.pos;
        let mut k = start;
        let neg = at(self.b, k) == 45;
        if neg {
            k += 1;
        }
        if !digit(at(self.b, k)) {
            return Err(syntax("not a number", start));
        }
        if at(self.b, k) == 48 && digit(at(self.b, k + 1)) {
            return Err(syntax("a leading zero in a number", start));
        }
        // Accumulated as a negative number so `i64.MIN` fits; checked
        // before each step, so overflow only stops the exact path.
        let mut n: i64 = 0;
        let mut fits = true;
        while digit(at(self.b, k)) {
            let d = (self.b[k] - 48) as i64;
            if fits && n >= (i64.MIN + d) / 10 {
                n = n * 10 - d;
            } else {
                fits = false;
            }
            k += 1;
        }
        let mut whole = true;
        if at(self.b, k) == 46 {
            k += 1;
            if !digit(at(self.b, k)) {
                return Err(syntax("not a number", start));
            }
            while digit(at(self.b, k)) {
                k += 1;
            }
            whole = false;
        }
        if at(self.b, k) == 101 || at(self.b, k) == 69 {
            k += 1;
            if at(self.b, k) == 43 || at(self.b, k) == 45 {
                k += 1;
            }
            if !digit(at(self.b, k)) {
                return Err(syntax("not a number", start));
            }
            while digit(at(self.b, k)) {
                k += 1;
            }
            whole = false;
        }
        self.pos = k;
        if whole && fits && (neg || n != i64.MIN) {
            return Ok(Value.Integer(if neg { n } else { -n }));
        }
        match parse_f64(text(cut(self.b, start, k))) {
            Some(x) if finite(x) => Ok(Value.Float(x)),
            Some(_) => Err(oops(ErrorKind.Overflow, "a number too large for f64", start)),
            None => Err(syntax("not a number", start)),
        }
    }
}
