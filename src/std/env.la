/**
 * std.env: the program's environment. Variables are
 * read-only; the working directory can change.
 * Values reach Lugha as bytes and become strings through
 * `string_from_utf8`, so a value that isn't UTF-8 is `None` here.
 */

/**
 * The environment variable `name`.
 * @param name the variable's name
 * @returns its value, or `None` when it is unset, isn't valid UTF-8, or `name` contains a NUL byte
 */
public fun get(name: string): Option<string> = match $os.env(name) {
    Some(bytes) => string_from_utf8(bytes).ok(),
    None => None,
};

/**
 * The program's current working directory.
 * @returns the directory, or `Err` with the system's message
 */
public fun current_dir(): Result<string, string> {
    let bytes = $os.cwd()?;
    string_from_utf8(bytes)
}

/**
 * Makes `path` the working directory of the whole program: relative paths, and every program `std.process` starts afterwards, use it.
 * @param path the new directory
 * @returns `Ok(0)`, or `Err` with the system's message
 */
public fun set_current_dir(path: string): Result<i64, string> = $os.chdir(path);
