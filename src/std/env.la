// std.env (v15, milestone 64): the program's environment. Variables are
// read-only; the working directory can change (v16, milestone 68).
// Values reach Lugha as bytes and become strings through
// `string_from_utf8`, so a value that isn't UTF-8 is `None` here.

// The variable `name`, or `None` when it is unset, isn't valid UTF-8, or
// `name` contains a NUL byte.
public fun get(name: string): Option<string> = match $os.env(name) {
    Some(bytes) => string_from_utf8(bytes).ok(),
    None => None,
};

// The current directory, or `Err` with the system's message.
public fun current_dir(): Result<string, string> {
    let bytes = $os.cwd()?;
    string_from_utf8(bytes)
}

// Makes `path` the working directory of the whole program (v16): relative
// paths and every program `std.process` starts afterwards use it. `Ok(0)`,
// or `Err` with the system's message.
public fun set_current_dir(path: string): Result<i64, string> = $os.chdir(path);
