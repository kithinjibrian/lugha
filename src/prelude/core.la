// The Lugha prelude (v3 draft §4, PRP-041): the array helpers behind
// `xs.map(f)`, `xs.filter(f)`, `xs.fold(init, f)`, `xs.sort_by(less)`,
// `xs.any(f)` and `xs.all(f)`. It is checked with every program and each
// helper is compiled only for the element types a program uses. Programs
// can't name this module; an array method call is the only way in.
//
// Every helper takes its array as an ordinary parameter, so the caller's
// array never changes, and every array it returns is new.

// Success or failure (v4 draft §4): `Ok` and `Err` are written without
// `Result.` in programs, and `?` returns an `Err` early.
enum Result<T, E> { Ok(T), Err(E) }

// `f` applied to each element, in order.
fun map<T, U>(xs: T[], f: fun(T): U): U[] {
    let mut out: U[] = [];
    for x of xs {
        out.push(f(x));
    }
    out
}

// The elements for which `keep` is true, in order.
fun filter<T>(xs: T[], keep: fun(T): bool): T[] {
    let mut out: T[] = [];
    for x of xs {
        if keep(x) {
            out.push(x);
        }
    }
    out
}

// `f(…f(f(init, xs[0]), xs[1])…)`, left to right.
fun fold<T, A>(xs: T[], init: A, f: fun(A, T): A): A {
    let mut acc = init;
    for x of xs {
        acc = f(acc, x);
    }
    acc
}

// True at the first element for which `f` is true; later ones aren't tested.
fun any<T>(xs: T[], f: fun(T): bool): bool {
    for x of xs {
        if f(x) {
            return true;
        }
    }
    false
}

// False at the first element for which `f` is false; later ones aren't tested.
fun all<T>(xs: T[], f: fun(T): bool): bool {
    for x of xs {
        if !f(x) {
            return false;
        }
    }
    true
}

// A stable bottom-up merge sort into a new array: runs of `width` are
// merged pairwise from `src` into `dst`, then the buffers trade places. On a
// tie the left run's element goes first, which keeps equal elements in
// their original order. An inconsistent `less` still gives back every
// element exactly once, in some order.
fun sort_by<T>(xs: T[], less: fun(T, T): bool): T[] {
    let n = xs.len;
    let mut src = xs;
    if n < 2 {
        return src;
    }
    let mut dst = xs;
    let mut width = 1;
    while width < n {
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if mid + width < n { mid + width } else { n };
            let mut a = lo;
            let mut b = mid;
            let mut k = lo;
            while k < hi {
                if a < mid && (b >= hi || !less(src[b], src[a])) {
                    dst[k] = src[a];
                    a += 1;
                } else {
                    dst[k] = src[b];
                    b += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        swap(src, dst);
        width *= 2;
    }
    src
}

// ---- Strings (v4 draft §4) ----
// Strings are bytes: these helpers compare and cut bytes, and `slice` (built
// into the compiler) makes each new string. ASCII codes: `\n` 10, `\r` 13,
// `\t` 9, space 32.

// The lines of `s`: split at `\n`, one trailing `\r` dropped from each, and
// no empty last line after a final `\n`.
fun str_lines(s: string): string[] {
    let mut out: string[] = [];
    let mut start = 0;
    for i in 0..s.len {
        if s[i] == 10 {
            out.push(str_line(s, start, i));
            start = i + 1;
        }
    }
    if start < s.len {
        out.push(str_line(s, start, s.len));
    }
    out
}

// The bytes `from..to` of `s` without a final `\r`.
fun str_line(s: string, from: i64, to: i64): string {
    if to > from && s[to - 1] == 13 {
        return s.slice(from, to - 1);
    }
    s.slice(from, to)
}

// The parts of `s` between occurrences of `sep`, empty parts kept.
fun str_split(s: string, sep: string): string[] {
    if sep.len == 0 {
        panic("split with an empty separator");
    }
    let mut out: string[] = [];
    let mut start = 0;
    let mut i = 0;
    while i + sep.len <= s.len {
        if str_at(s, i, sep) {
            out.push(s.slice(start, i));
            i += sep.len;
            start = i;
        } else {
            i += 1;
        }
    }
    out.push(s.slice(start, s.len));
    out
}

// True if `p` occurs in `s` starting at byte `at`.
fun str_at(s: string, at: i64, p: string): bool {
    if at + p.len > s.len {
        return false;
    }
    for k in 0..p.len {
        if s[at + k] != p[k] {
            return false;
        }
    }
    true
}

// ASCII whitespace: space, `\t`, `\n`, `\r`.
fun str_is_space(b: u8): bool = b == 32 || b == 9 || b == 10 || b == 13;

// `s` without leading and trailing ASCII whitespace.
fun str_trim(s: string): string {
    let mut from = 0;
    let mut to = s.len;
    while from < to && str_is_space(s[from]) {
        from += 1;
    }
    while to > from && str_is_space(s[to - 1]) {
        to -= 1;
    }
    s.slice(from, to)
}

fun str_contains(s: string, sub: string): bool {
    for i in 0..s.len - sub.len + 1 {
        if str_at(s, i, sub) {
            return true;
        }
    }
    false
}

fun str_starts_with(s: string, p: string): bool = str_at(s, 0, p);

fun str_ends_with(s: string, p: string): bool = p.len <= s.len && str_at(s, s.len - p.len, p);

// The strings of `xs` with `sep` between them.
fun str_join(xs: string[], sep: string): string {
    let mut out = "";
    for i in 0..xs.len {
        if i > 0 {
            out = out + sep;
        }
        out = out + xs[i];
    }
    out
}

// ---- Option and Result (v4 draft §4) ----

fun option_unwrap_or<T>(o: Option<T>, default: T): T = match o {
    Some(x) => x,
    None => default,
};

fun option_ok_or<T, E>(o: Option<T>, error: E): Result<T, E> = match o {
    Some(x) => Ok(x),
    None => Err(error),
};

fun option_map<T, U>(o: Option<T>, f: fun(T): U): Option<U> = match o {
    Some(x) => Some(f(x)),
    None => None,
};

fun option_is_some<T>(o: Option<T>): bool = match o {
    Some(_) => true,
    None => false,
};

fun option_is_none<T>(o: Option<T>): bool = !option_is_some(o);

fun result_unwrap_or<T, E>(r: Result<T, E>, default: T): T = match r {
    Ok(x) => x,
    Err(_) => default,
};

fun result_ok<T, E>(r: Result<T, E>): Option<T> = match r {
    Ok(x) => Some(x),
    Err(_) => None,
};

fun result_map<T, E, U>(r: Result<T, E>, f: fun(T): U): Result<U, E> = match r {
    Ok(x) => Ok(f(x)),
    Err(e) => Err(e),
};

fun result_map_err<T, E, F>(r: Result<T, E>, f: fun(E): F): Result<T, F> = match r {
    Ok(x) => Ok(x),
    Err(e) => Err(f(e)),
};

fun result_is_ok<T, E>(r: Result<T, E>): bool = match r {
    Ok(_) => true,
    Err(_) => false,
};

fun result_is_err<T, E>(r: Result<T, E>): bool = !result_is_ok(r);

// Anything that can be stepped through (v6 draft §4): `for x of e` loops
// over any `e` with this `next`, whether or not it names `Iter`.
interface Iter<T> { fun next(mut self): Option<T>; }
