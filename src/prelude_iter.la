
// Iterator helpers (v10 draft §4, milestone 36), joined after `prelude.la`
// into the one prelude module. `xs.iter()`, `s.bytes()` and `range(a, b)`
// make iterators; `it.map(f)` and the other adapters wrap one lazily, so
// nothing runs until a loop or a consumer (`it.sum()`, …) pulls values.
// Each helper takes its iterator as an `Iter<T>` value, a copy, so the
// caller's iterator never moves.

// The elements of an array, in order: `xs.iter()`.
struct ArrayIter<T> { xs: T[], at: i64 }

impl ArrayIter<T> {
    fun next(mut self): Option<T> {
        if self.at == self.xs.len {
            return None;
        }
        self.at += 1;
        Some(self.xs[self.at - 1])
    }
}

fun array_iter<T>(xs: T[]): ArrayIter<T> = ArrayIter { xs: xs, at: 0 };

// The bytes of a string: `s.bytes()`.
struct Bytes { s: string, at: i64 }

impl Bytes {
    fun next(mut self): Option<u8> {
        if self.at == self.s.len {
            return None;
        }
        self.at += 1;
        Some(self.s[self.at - 1])
    }
}

fun str_bytes(s: string): Bytes = Bytes { s: s, at: 0 };

// `from`, `from + 1`, … up to `to - 1`: `range(from, to)`.
struct Range { at: i64, end: i64 }

impl Range {
    fun next(mut self): Option<i64> {
        if self.at >= self.end {
            return None;
        }
        self.at += 1;
        Some(self.at - 1)
    }
}

fun range(from: i64, to: i64): Range = Range { at: from, end: to };

// `f` of each value: `it.map(f)`.
struct Map<T, U> { src: Iter<T>, f: fun(T): U }

impl Map<T, U> {
    fun next(mut self): Option<U> = match self.src.next() {
        Some(x) => Some(self.f(x)),
        None => None,
    };
}

fun iter_map<T, U>(it: Iter<T>, f: fun(T): U): Map<T, U> = Map { src: it, f: f };

// The values `keep` is true for: `it.filter(keep)`.
struct Filter<T> { src: Iter<T>, keep: fun(T): bool }

impl Filter<T> {
    fun next(mut self): Option<T> {
        while let Some(x) = self.src.next() {
            if self.keep(x) {
                return Some(x);
            }
        }
        None
    }
}

fun iter_filter<T>(it: Iter<T>, keep: fun(T): bool): Filter<T> = Filter { src: it, keep: keep };

// The first `n` values, then nothing more is pulled: `it.take(n)`.
struct Take<T> { src: Iter<T>, left: i64 }

impl Take<T> {
    fun next(mut self): Option<T> {
        if self.left <= 0 {
            return None;
        }
        self.left -= 1;
        self.src.next()
    }
}

fun iter_take<T>(it: Iter<T>, n: i64): Take<T> = Take { src: it, left: n };

// Every value after the first `n`: `it.skip(n)`.
struct Skip<T> { src: Iter<T>, left: i64 }

impl Skip<T> {
    fun next(mut self): Option<T> {
        while self.left > 0 {
            self.left -= 1;
            if let None = self.src.next() {
                self.left = 0;
                return None;
            }
        }
        self.src.next()
    }
}

fun iter_skip<T>(it: Iter<T>, n: i64): Skip<T> = Skip { src: it, left: n };

// A value with its position, counting from 0: what `it.enumerate()` yields.
struct Indexed<T> { public i: i64, public value: T }

struct Enumerate<T> { src: Iter<T>, at: i64 }

impl Enumerate<T> {
    fun next(mut self): Option<Indexed<T>> = match self.src.next() {
        Some(x) => {
            self.at += 1;
            Some(Indexed { i: self.at - 1, value: x })
        }
        None => None,
    };
}

fun iter_enumerate<T>(it: Iter<T>): Enumerate<T> = Enumerate { src: it, at: 0 };

// Every value, in order: `it.collect()`.
fun iter_collect<T>(it: Iter<T>): T[] {
    let mut out: T[] = [];
    for x of it {
        out.push(x);
    }
    out
}

fun iter_count<T>(it: Iter<T>): i64 {
    let mut n = 0;
    for x of it {
        n += 1;
    }
    n
}

fun iter_fold<T, A>(it: Iter<T>, init: A, f: fun(A, T): A): A {
    let mut acc = init;
    for x of it {
        acc = f(acc, x);
    }
    acc
}

fun iter_any<T>(it: Iter<T>, f: fun(T): bool): bool {
    for x of it {
        if f(x) {
            return true;
        }
    }
    false
}

fun iter_all<T>(it: Iter<T>, f: fun(T): bool): bool {
    for x of it {
        if !f(x) {
            return false;
        }
    }
    true
}

fun iter_find<T>(it: Iter<T>, f: fun(T): bool): Option<T> {
    for x of it {
        if f(x) {
            return Some(x);
        }
    }
    None
}

// `it.sum()`, one per number type; `+` panics on overflow as usual.
fun iter_sum_i8(it: Iter<i8>): i8 {
    let mut total: i8 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_i16(it: Iter<i16>): i16 {
    let mut total: i16 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_i32(it: Iter<i32>): i32 {
    let mut total: i32 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_i64(it: Iter<i64>): i64 {
    let mut total: i64 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_u8(it: Iter<u8>): u8 {
    let mut total: u8 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_u16(it: Iter<u16>): u16 {
    let mut total: u16 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_u32(it: Iter<u32>): u32 {
    let mut total: u32 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_u64(it: Iter<u64>): u64 {
    let mut total: u64 = 0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_f32(it: Iter<f32>): f32 {
    let mut total: f32 = 0.0;
    for x of it {
        total += x;
    }
    total
}

fun iter_sum_f64(it: Iter<f64>): f64 {
    let mut total: f64 = 0.0;
    for x of it {
        total += x;
    }
    total
}

// A type's own text (v12 draft §4): a struct or enum with this `show`
// prints through it; every other value has a built-in form.
interface Display { fun show(self): string; }
